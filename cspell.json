{
  "$schema": "https://raw.githubusercontent.com/streetsidesoftware/cspell/main/cspell.schema.json",
  "version": "0.2",
  "id": "cspell-lynx-website-config",
  "name": "cspell check for lynx website",
  "language": "en",
  "words": [
    "AAEC",
    "ALOG",
    "Dugyu",
    "GHC",
    "JSBI",
    "Jiahan",
    "Jingkai",
    "KananSu",
    "Leron",
    "NSEC",
    "NSJSONSerialization",
    "NSUTF8StringEncoding",
    "Neilcc",
    "Octane",
    "Preact",
    "Qiang",
    "Shouqun",
    "VWVH",
    "Xuan",
    "Zhang",
    "Zhao",
    "backtrace",
    "baiqiang",
    "chenjiahan",
    "colinaaa",
    "devtoolwrapper",
    "douyinfe",
    "gaoachao",
    "genui",
    "hilog",
    "hprof",
    "huxpro",
    "icecreamx",
    "impls",
    "jank",
    "janks",
    "jkzing",
    "jridgewell",
    "kapt",
    "krausest",
    "lepus",
    "lepusCode",
    "libc",
    "liblynxdevtool",
    "liujilong",
    "liushouqun",
    "llms",
    "luhc",
    "luhc228",
    "lynxjs",
    "minalwws",
    "miso",
    "nesw",
    "nwse",
    "ohos",
    "ohpm",
    "onum",
    "openui",
    "opsz",
    "pipx",
    "rdream",
    "rstest",
    "shiwentao",
    "tiktoken",
    "unshallow",
    "vdom",
    "wght",
    "worklet",
    "zhangfacheng",
    "zhaosong",
    "zjkdddd"
  ],
  "maxNumberOfProblems": 1000,
  "useGitignore": true,
  "ignorePaths": [
    "*.snap",
    "node_modules",
    "__snapshots__",
    "package-lock.json",
    "coverage/**",
    "dist/**",
    "dist.*/**",
    "temp/**",
    "CHANGELOG.md",
    "package.json",
    "packages/lynx-cdp",
    ".cspell.json",
    "cspell.json",
    ".vscode/**",
    "**/docs-contribution-guide/**",
    ".trae/**"
  ],
  "dictionaryDefinitions": [
    {
      "name": "lynx-words",
      "path": "./.cspell/dictionary.txt",
      "description": "lynx words",
      "addWords": true
    },
    {
      "name": "developer-id",
      "path": "./.cspell/developer-id.txt",
      "description": "developer id",
      "addWords": true
    }
  ],
  "allowCompoundWords": true,
  "dictionaries": [
    "lynx-words",
    "softwareTerms",
    "typescript",
    "node"
  ],
  "noConfigSearch": true,
  "ignoreWords": []
}